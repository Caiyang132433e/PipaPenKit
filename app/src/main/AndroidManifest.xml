<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_edit"
        android:label="PipaPenKit"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="PipaPenKit">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pipa" android:host="open" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:label="PipaPenKit"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".PenTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_edit"
            android:label="PipaPenKit"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="4242" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ConfigProvider"
            android:authorities="com.pipa.penkit.config"
            android:enabled="true"
            android:exported="true" />

        <receiver
            android:name=".LogReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pipa.penkit.LOG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
